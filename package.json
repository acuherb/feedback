{
  "name": "acuherb-feedback",
  "version": "0.1.0",
  "description": "轻量级反馈板，基于 HTMX + Cloudflare Workers + D1。",
  "type": "module",
  "scripts": {
    "dev": "wrangler d1 migrations apply feedback-db --local && wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler d1 migrations apply feedback-db --remote && wrangler deploy",
    "test": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acuherb/feedback.git"
  },
  "keywords": ["feedback", "htmx", "cloudflare-workers", "d1", "hono"],
  "author": "Acuherb",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/acuherb/feedback/issues"
  },
  "homepage": "https://github.com/acuherb/feedback#readme",
  "dependencies": {
    "hono": "^4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4",
    "wrangler": "^4.61.1"
  }
}